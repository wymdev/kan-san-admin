APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kan_san
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Existing installations: keep DB_* on MySQL until the verified copy is complete.
PG_MIGRATION_HOST=127.0.0.1
PG_MIGRATION_PORT=5432
PG_MIGRATION_DATABASE=kan_san
PG_MIGRATION_USERNAME=postgres
PG_MIGRATION_PASSWORD=
PG_MIGRATION_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Use log locally; set MAIL_MAILER=brevo and BREVO_KEY for email delivery.
MAIL_MAILER=log
BREVO_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Used by the mobile app API; this is separate from the public results provider.
API_KEY=
# Optional authenticated Expo push delivery.
EXPO_ACCESS_TOKEN=

# Gemini API for Vision OCR
GOOGLE_GENERATIVE_AI_API_KEY=

# Public results provider; no provider API key required.
LOTTERY_RESULTS_BASE_URL=https://xn--t3cmiit.com
